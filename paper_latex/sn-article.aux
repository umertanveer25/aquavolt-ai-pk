\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Operational resilience and fault-tolerant imputation during the 9-day consecutive satellite telemetry blackout (July 25 to August 3, 2026). (a) Satellite telemetry ingestion timeline showing uninterrupted optical acquisition (June 28--July 24), the 9-day Sentinel-2 API blackout, and automated re-synchronization on August 3; (b) Comparative trajectory showing catastrophic divergence in unconstrained neural networks (dashed red line) versus continuous, bounded state propagation in AquaVolt-AI (solid blue line); (c) Dynamic decay kinetics of basal crop transpiration persistence ($K_{cb}(t)$) and Stage-2 topsoil evaporation drying rate ($K_e(t)$) maintaining bounded evapotranspiration estimates ($\mathrm  {RMSE} \le 0.32\text  { mm/day}$).}}{23}{figure.5}\protected@file@percent }
\newlabel{fig:imputation_gap}{{5}{23}{Operational resilience and fault-tolerant imputation during the 9-day consecutive satellite telemetry blackout (July 25 to August 3, 2026). (a) Satellite telemetry ingestion timeline showing uninterrupted optical acquisition (June 28--July 24), the 9-day Sentinel-2 API blackout, and automated re-synchronization on August 3; (b) Comparative trajectory showing catastrophic divergence in unconstrained neural networks (dashed red line) versus continuous, bounded state propagation in AquaVolt-AI (solid blue line); (c) Dynamic decay kinetics of basal crop transpiration persistence ($K_{cb}(t)$) and Stage-2 topsoil evaporation drying rate ($K_e(t)$) maintaining bounded evapotranspiration estimates ($\mathrm {RMSE} \le 0.32\text { mm/day}$)}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.8}AWD Water Table, Redox Potential ($E_h$), and Methane Flux Dynamics}{24}{subsection.5.8}\protected@file@percent }
\newlabel{sec:results_awd_dynamics}{{5.8}{24}{AWD Water Table, Redox Potential ($E_h$), and Methane Flux Dynamics}{subsection.5.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Biophysical coupling between perched water table fluctuations, soil redox potential ($E_h$), and methane flux dynamics during Alternate Wetting and Drying (AWD) management. (a) Water table depth showing three cyclic drying intervals down to the safe AWD threshold ($-15\text  { cm}$); (b) Soil redox potential ($E_h$, red curve) responding to aeration with a 1.5-day time lag, transitioning from methanogenic reduction ($<-150\text  { mV}$) to aerobic oxidation ($>+150\text  { mV}$); (c) Methane flux ($\mathrm  {CH}_4$, green curve) dropping to near-zero ($<0.1\text  { mg}\cdot \text  {m}^{-2}\cdot \text  {h}^{-1}$) whenever $E_h > -150\text  { mV}$, verifying the physical mechanism of AWD emission abatement.}}{24}{figure.6}\protected@file@percent }
\newlabel{fig:awd_redox_flux}{{6}{24}{Biophysical coupling between perched water table fluctuations, soil redox potential ($E_h$), and methane flux dynamics during Alternate Wetting and Drying (AWD) management. (a) Water table depth showing three cyclic drying intervals down to the safe AWD threshold ($-15\text { cm}$); (b) Soil redox potential ($E_h$, red curve) responding to aeration with a 1.5-day time lag, transitioning from methanogenic reduction ($<-150\text { mV}$) to aerobic oxidation ($>+150\text { mV}$); (c) Methane flux ($\mathrm {CH}_4$, green curve) dropping to near-zero ($<0.1\text { mg}\cdot \text {m}^{-2}\cdot \text {h}^{-1}$) whenever $E_h > -150\text { mV}$, verifying the physical mechanism of AWD emission abatement}{figure.6}{}}
