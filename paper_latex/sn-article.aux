\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Empirical validation and residual regression scatter plot of AquaVolt-AI daily predicted crop evapotranspiration ($\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {ET}$}\mathaccent "0362{\mathrm  {ET}}_c$) against physical CIMIS Station \#6 automated ground measurements over the 36-day campaign ($N = 36$). The solid black line denotes the $1:1$ line of perfect agreement ($y = x$), dashed lines delineate the $\pm 10\%$ error envelope, and markers are colored by canopy NDVI. Residual analysis demonstrates homoscedastic error dispersion ($\mathrm  {RMSE} = 0.3000\text  { mm/day}$, $\mathrm  {MAE} = 0.2688\text  { mm/day}$), confirming unbiased predictions across high evaporative demand regimes ($5.5\text  { to }7.5\text  { mm/day}$).}}{20}{figure.3}\protected@file@percent }
\newlabel{fig:validation_scatter}{{3}{20}{Empirical validation and residual regression scatter plot of AquaVolt-AI daily predicted crop evapotranspiration ($\widehat {\mathrm {ET}}_c$) against physical CIMIS Station \#6 automated ground measurements over the 36-day campaign ($N = 36$). The solid black line denotes the $1:1$ line of perfect agreement ($y = x$), dashed lines delineate the $\pm 10\%$ error envelope, and markers are colored by canopy NDVI. Residual analysis demonstrates homoscedastic error dispersion ($\mathrm {RMSE} = 0.3000\text { mm/day}$, $\mathrm {MAE} = 0.2688\text { mm/day}$), confirming unbiased predictions across high evaporative demand regimes ($5.5\text { to }7.5\text { mm/day}$)}{figure.3}{}}
